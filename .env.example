ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
MONGODB_URI=mongodb://localhost:27017/web_intelligence
MONGODB_DB_NAME=web_intelligence

# PostGIS (OSM business ingest) — host port 5433 to avoid clashing with local Postgres
POSTGIS_HOST=localhost
POSTGIS_PORT=5433
POSTGIS_USER=osm
POSTGIS_PASSWORD=osm
POSTGIS_DB=osm_businesses
POSTGIS_DSN=postgresql://osm:osm@localhost:5433/osm_businesses

# OSM planet ingest
OSM_DATA_DIR=./data/osm
OSM_PLANET_URL=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf
OSM_PLANET_MD5_URL=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf.md5
OSM_REPLICATION_BASE_URL=https://planet.openstreetmap.org/replication/hour
OSM_BATCH_SIZE=10000
OSM_OSMIUM_BIN=osmium
OSM_TAGS_CONFIG=osm_ingest/config/business_tags.yaml
# Use dense_file_array for full-planet way geometries if RAM is limited
OSM_LOCATION_STORE=flex_mem

# Queue processing
QUEUE_WORKERS=5
MAX_RETRIES=3
QUEUE_BATCH_SIZE=100
QUEUE_POLL_INTERVAL_SECONDS=2
QUEUE_STALE_JOB_SECONDS=3600
QUEUE_SHUTDOWN_TIMEOUT_SECONDS=300

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# Ollama — true = remote URL; false = local Docker Ollama
OLLAMA_USE_REMOTE=false
# Required for local: enables the ollama service in docker-compose.yml
COMPOSE_PROFILES=local-ollama
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_REMOTE_URL=https://providing-race-reenact.ngrok-free.dev
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_NUM_PREDICT=2048
# CPU-only Ollama: keep at 1 so concurrent QUEUE_WORKERS queue at Ollama
# instead of running in parallel and thrashing the CPU (tanks tokens/sec).
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Agent LLM context limits (keep prompts small for local Ollama)
AGENT_CONTEXT_MAX_PAGES=3
AGENT_CONTEXT_MAX_CHARS_PER_PAGE=1200

# Qdrant
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=

# Embeddings (replaceable provider)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Crawler
CRAWLER_MAX_PAGES=5
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_CONCURRENCY=3

# Hybrid crawler (keep Colly healthy: docker compose up -d colly-sidecar)
USE_WEBCLAW_FALLBACK=true
COLLY_URL=http://localhost:8081
COLLY_TIMEOUT_SECONDS=20
WEBCLAW_BASE_URL=http://localhost:3010
CRAWLER_MAX_RETRIES=3
CRAWLER_RETRY_BACKOFF_SECONDS=2
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_MIN_HTML_LENGTH=500

# Default user for v1 (no auth)
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_NAME=Default Admin

# Outbound crawl proxy (used when PROXY_ENABLED=true)
PROXY_ENABLED=false
PROXY_HOST=p.webshare.io
PROXY_PORT=80
PROXY_USERNAME=
PROXY_PASSWORD=
# Same URL the webclaw container uses (http://USER:PASS@HOST:PORT). Empty when disabled.
WEBCLAW_PROXY=
